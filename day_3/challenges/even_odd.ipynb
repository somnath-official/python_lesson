   "source": [
    "## Write a python script to determine whether a number given by user is even or odd"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "03a6d663",
   "metadata": {},
   "outputs": [],
   "source": [
    "number = int(input(\"Enter a number: \"))\n",
    "\n",
    "if number % 2 == 0:\n",
    "    print(\"Even number.\")\n",
    "else:\n",
    "    print(\"Odd number.\")"
   ]
  }
 ],
